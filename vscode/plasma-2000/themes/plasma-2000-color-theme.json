    "tokenColors": [
        {
            "settings": {
                "foreground": "#000000"
            }
        },
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment", "comment.block.documentation"],
            "settings": { "foreground": "#008000" }
        },
        {
            "name": "Doc comment tags",
            "scope": ["storage.type.class.jsdoc", "keyword.other.phpdoc", "comment.block.documentation keyword", "entity.name.type.instance.jsdoc"],
            "settings": { "foreground": "#808080" }
        },
        {
            "name": "Keywords",
            "scope": ["keyword", "storage", "storage.type", "storage.modifier", "keyword.control", "keyword.operator.new", "keyword.operator.expression", "keyword.operator.logical.python", "keyword.operator.wordlike", "keyword.operator.sizeof", "keyword.operator.instanceof", "keyword.operator.typeof", "variable.language", "constant.language", "support.type.primitive", "support.type.builtin", "entity.name.type.primitive"],
            "settings": { "foreground": "#0000ff" }
        },
        {
            "name": "Operators and punctuation",
            "scope": ["keyword.operator", "punctuation"],
            "settings": { "foreground": "#000000" }
        },
        {
            "name": "Preprocessor",
            "scope": ["meta.preprocessor", "keyword.control.directive", "punctuation.definition.directive", "entity.name.function.preprocessor", "keyword.control.import", "keyword.control.export", "keyword.control.from"],
            "settings": { "foreground": "#0000ff" }
        },
        {
            "name": "Strings",
            "scope": ["string", "punctuation.definition.string", "string.quoted", "string.template", "markup.inline.raw"],
            "settings": { "foreground": "#800000" }
        },
        {
            "name": "Escapes, placeholders, regex",
            "scope": ["constant.character.escape", "constant.other.placeholder", "constant.character.format.placeholder", "string.regexp", "punctuation.definition.template-expression", "punctuation.section.embedded"],
            "settings": { "foreground": "#800080" }
        },
        {
            "name": "Embedded code in strings",
            "scope": ["meta.template.expression", "meta.embedded"],
            "settings": { "foreground": "#000000" }
        },
        {
            "name": "Numbers and constants",
            "scope": ["constant.numeric", "constant.character", "constant.other", "variable.other.enummember", "support.constant"],
            "settings": { "foreground": "#800080" }
        },
        {
            "name": "Types and classes",
            "scope": ["entity.name.type", "entity.name.class", "entity.name.namespace", "entity.name.scope-resolution", "entity.other.inherited-class", "support.class", "support.type", "storage.type.java", "storage.type.cs", "meta.type.cast.expr", "entity.name.type.parameter"],
            "settings": { "foreground": "#008080" }
        },
        {
            "name": "Functions",
            "scope": ["entity.name.function", "support.function", "meta.function-call entity.name.function", "variable.function"],
            "settings": { "foreground": "#000080" }
        },
        {
            "name": "Variables and parameters",
            "scope": ["variable", "variable.parameter", "variable.other", "meta.definition.variable.name", "support.variable", "entity.name.variable"],
            "settings": { "foreground": "#000000" }
        },
        {
            "name": "Decorators and attributes",
            "scope": ["meta.decorator", "punctuation.decorator", "entity.name.function.decorator", "meta.attribute", "storage.type.annotation", "punctuation.definition.annotation"],
            "settings": { "foreground": "#808000" }
        },
        {
            "name": "Labels",
            "scope": ["entity.name.label", "entity.name.goto-label"],
            "settings": { "foreground": "#808000" }
        },
        {
            "name": "Shell commands",
            "scope": ["support.function.builtin.shell", "entity.name.command.shell"],
            "settings": { "foreground": "#000080" }
        },
        {
            "name": "HTML/XML tags (Visual InterDev)",
            "scope": ["entity.name.tag", "punctuation.definition.tag", "meta.tag.sgml", "meta.tag.metadata.doctype"],
            "settings": { "foreground": "#800000" }
        },
        {
            "name": "Tag attributes",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#ff0000" }
        },
        {
            "name": "Attribute values",
            "scope": ["meta.attribute string", "meta.tag string.quoted", "meta.attribute-with-value string"],
            "settings": { "foreground": "#0000ff" }
        },
        {
            "name": "Character entities",
            "scope": ["constant.character.entity", "punctuation.definition.entity"],
            "settings": { "foreground": "#ff0000" }
        },
        {
            "name": "CSS selectors",
            "scope": ["entity.other.attribute-name.class.css", "entity.other.attribute-name.id.css", "entity.other.attribute-name.pseudo-class.css", "entity.other.attribute-name.pseudo-element.css", "entity.name.tag.css"],
            "settings": { "foreground": "#800000" }
        },
        {
            "name": "CSS properties",
            "scope": ["support.type.property-name", "support.type.vendored.property-name", "meta.property-name"],
            "settings": { "foreground": "#ff0000" }
        },
        {
            "name": "CSS values",
            "scope": ["support.constant.property-value", "support.constant.color", "constant.other.color", "keyword.other.unit", "meta.property-value"],
            "settings": { "foreground": "#0000ff" }
        },
        {
            "name": "JSON/YAML/TOML keys",
            "scope": ["support.type.property-name.json", "entity.name.tag.yaml", "support.type.property-name.toml", "keyword.key.toml", "variable.other.key.toml", "entity.name.tag.toml"],
            "settings": { "foreground": "#000080" }
        },
        {
            "name": "INI sections",
            "scope": ["entity.name.section", "entity.name.section.group-title.ini"],
            "settings": { "foreground": "#000080", "fontStyle": "bold" }
        },
        {
            "name": "Markdown headings",
            "scope": ["markup.heading", "markup.heading entity.name", "punctuation.definition.heading"],
            "settings": { "foreground": "#000080", "fontStyle": "bold" }
        },
        {
            "name": "Markdown emphasis",
            "scope": ["markup.bold"],
            "settings": { "fontStyle": "bold" }
        },
        {
            "scope": ["markup.italic"],
            "settings": { "fontStyle": "italic" }
        },
        {
            "scope": ["markup.strikethrough"],
            "settings": { "fontStyle": "strikethrough" }
        },
        {
            "name": "Markdown links",
            "scope": ["markup.underline.link", "string.other.link", "meta.link.inline"],
            "settings": { "foreground": "#0000ff" }
        },
        {
            "name": "Markdown lists and quotes",
            "scope": ["punctuation.definition.list.begin.markdown", "markup.quote", "beginning.punctuation.definition.list"],
            "settings": { "foreground": "#808080" }
        },
        {
            "name": "Diff",
            "scope": ["markup.inserted", "meta.diff.header.to-file", "punctuation.definition.inserted"],
            "settings": { "foreground": "#008000" }
        },
        {
            "scope": ["markup.deleted", "meta.diff.header.from-file", "punctuation.definition.deleted"],
            "settings": { "foreground": "#800000" }
        },
        {
            "scope": ["markup.changed", "punctuation.definition.changed"],
            "settings": { "foreground": "#000080" }
        },
        {
            "scope": ["meta.diff.range", "meta.diff.header"],
            "settings": { "foreground": "#808080" }
        },
        {
            "name": "Invalid",
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#ff0000" }
        },
        {
            "scope": ["invalid.deprecated"],
            "settings": { "foreground": "#808080", "fontStyle": "strikethrough" }
        }
    ],
    "semanticTokenColors": {
        "namespace": "#008080",
        "class": "#008080",
        "struct": "#008080",
        "enum": "#008080",
        "interface": "#008080",
        "type": "#008080",
        "typeParameter": "#008080",
        "function": "#000080",
        "method": "#000080",
        "macro": "#0000ff",
        "enumMember": "#800080",
        "variable.defaultLibrary": "#000000",
        "parameter": "#000000",
        "property": "#000000",
        "variable": "#000000",
        "decorator": "#808000",
        "label": "#808000"
    }
}
